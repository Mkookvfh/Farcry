static unsigned int rng_state = 12345u;

static int rnd_i(void)
{
    rng_state = rng_state * 1103515245u + 12345u;
    return (int)((rng_state >> 16) & 0x7fff);
}

static float rnd_f(void)
{
    return rnd_i() / 32768.0f;
}

