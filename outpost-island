static int   pad_buttons = 0, pad_prev = 0;
static float stick_lx = 0, stick_ly = 0, stick_rx = 0, stick_ry = 0;

#define HELD(b)    (pad_buttons & (b))
#define PRESSED(b) ((pad_buttons & (b)) && !(pad_prev & (b)))

static void pad_wait_stable(void)
{
    int i, st;
    for (i = 0; i < 200000; i++) {
        st = padGetState(0, 0);
        if (st == PAD_STATE_STABLE || st == PAD_STATE_FINDCTP1)
            break;
    }
}

static void init_pad(void)
{
    SifInitRpc(0);
    SifLoadModule("rom0:SIO2MAN", 0, NULL);
    SifLoadModule("rom0:PADMAN", 0, NULL);
    padInit(0);
    padPortOpen(0, 0, padBuf);
    pad_wait_stable();